FROM osrf/ros:jazzy-desktop-full

SHELL [ "/bin/bash" , "-c" ]

RUN apt-get update && apt-get install -y \
    git-all \
    python3-vcstool \
    python3-rosdep \
    python3-colcon-common-extensions \
    wget \
    curl

WORKDIR /root/openmore_ws/src
RUN git clone --recurse-submodules https://github.com/JRL-CARI-CNR-UNIBS/OpenMORE.git -b ros2
WORKDIR /root/openmore_ws
RUN vcs import src < src/OpenMORE/deps.repos --recursive

RUN rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y \
    && rm -rf /var/lib/apt/lists/*

RUN source /opt/ros/$ROS_DISTRO/setup.bash && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release

CMD ["/bin/bash"]
